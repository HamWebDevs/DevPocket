{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HamWebDevs/DevPocket/v1/devpocket/schemas/project-v1.json",
  "title": "DevPocket project configuration v1",
  "description": "Editor assistance. Runtime validation additionally enforces DAG references, paths, resources and installed tool inputs.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "version": {
      "const": 1
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "uniqueItems": true
    },
    "checks": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "maxProperties": 100,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "input": {
            "type": "object"
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "timeout": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 3600
          },
          "allow_failure": {
            "type": "boolean"
          },
          "cache": {
            "type": "object",
            "properties": {
              "inputs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "maxItems": 32,
                "minItems": 1
              },
              "env": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
                },
                "maxItems": 32
              },
              "max_age": {
                "type": "number",
                "minimum": 1,
                "maximum": 604800
              }
            },
            "required": [
              "inputs"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "tool"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version"
  ],
  "additionalProperties": false
}
